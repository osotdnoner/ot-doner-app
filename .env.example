# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# На компьютере — True. На сервере обязательно False.
DEBUG=True

# На сервере: длинная случайная строка (python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=

# Адреса, по которым открывается приложение (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1
# На сервере: https://ваш-домен.kz
CSRF_TRUSTED_ORIGINS=

# Пусто — используется файл db.sqlite3. На сервере — PostgreSQL:
# DATABASE_URL=postgres://otdoner:пароль@localhost:5432/otdoner
DATABASE_URL=

# --- Уведомления (пока можно оставить пустыми: сообщения будут только в логе и в панели) ---
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# WhatsApp Business Platform от Meta: постоянный токен системного пользователя и Phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Имя одобренного шаблона. Оставьте пустым, чтобы слать обычный текст (только для проверки)
WHATSAPP_TEMPLATE=otdoner_alert

# Отметиться можно за столько минут до начала смены
CHECKIN_EARLY_MINUTES=60
# Если GPS точнее этого числа метров не определяет — просим подождать
CHECKIN_MAX_ACCURACY_M=150

# --- Зарплатная таблица в Google (см. README «Зарплатная таблица в Google») ---
# Адрес веб-приложения Apps Script (заканчивается на /exec) и секретное слово из скрипта
GOOGLE_SHEET_URL=
GOOGLE_SHEET_SECRET=
